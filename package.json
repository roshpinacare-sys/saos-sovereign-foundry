{
  "name": "saos-sovereign-foundry",
  "version": "2.0.0",
  "private": true,
  "description": "SAOS Sovereign Foundry v2 — cross-network anchoring, energy sovereignty and evidence-carrying economy platform. אנחנו מנצחים את הבלוקצ'יין",
  "scripts": {
    "dev": "next dev -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/api-check.mjs",
    "verify": "node scripts/concurrency-check.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run verify",
    "build": "next build",
    "backup": "bun scripts/backup.mjs",
    "restore": "bun scripts/restore.mjs",
    "cleanup": "bun scripts/cleanup.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "prisma": "^6.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "@eslint/eslintrc": "^3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
