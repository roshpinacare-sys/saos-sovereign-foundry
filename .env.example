# SAOS Sovereign Foundry — environment template (no real values here!)
# Copy to .env and fill in. .env is gitignored — NEVER commit it.

# Database (SQLite)
DATABASE_URL="file:./db/custom.db"

# ─── Operation mode (double-flag live protection) ───
# dry-run (default) | safe | live | maintenance
SAOS_MODE=dry-run
# Required IN ADDITION to SAOS_MODE=live — missing either falls back to dry-run
SAOS_LIVE_CONFIRM=

# ─── Access control (Task 5) ───
# sha256-hex of the admin key — NEVER the key itself:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_KEY').digest('hex'))"
SAOS_ADMIN_KEY_HASH=
# Optional explicit session secret (>=16 chars); default derives from the key hash
SAOS_SESSION_SECRET=
# Session lifetime in hours (default 12)
SAOS_SESSION_TTL_H=12

# ─── Rate limits (requests/minute, optional overrides) ───
# SAOS_RL_STATUS_PER_MIN=120
# SAOS_RL_SEAL_PER_MIN=30
# SAOS_RL_VERIFY_CHAIN_PER_MIN=60
# SAOS_RL_AUTH_PER_MIN=8
# SAOS_RL_LIVE_PROOF_PER_MIN=6
# SAOS_RL_BREAKTHROUGH_DEMO_PER_MIN=10

# ─── Signing queue (Task 5) ───
# SignRequest lifetime in hours (default 24)
SAOS_SIGN_TTL_H=24

# ─── Network resource levels (advisory computation inputs, no live calls) ───
HIVE_RC_PCT=0.6
TRON_ENERGY=0

# ─── Task 12: Ethereum & Solana (dry-run only, optional) ───
# Names only — NEVER put real keys in this file or in the repo.
# Public, keyless RPC → read-only checks become possible (probe is opt-in).
# An RPC with an embedded key must NEVER be committed; the system refuses
# URLs with credentials or key-like query params by design.
ETH_RPC_URL=
# Chain id (numeric or 0x-hex) — optional; left empty = unknown (never invented)
ETH_CHAIN_ID=
SOL_RPC_URL=
# Cluster NAME only: mainnet-beta | devnet | testnet | localnet
SOL_CLUSTER=
