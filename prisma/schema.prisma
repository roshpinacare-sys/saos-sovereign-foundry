// SAOS Sovereign Foundry v2 — data model
// The platform state: sovereign chain seals, public anchors, energy plans,
// economy simulations, evidence receipts and the research verdict ledger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Sovereign chain: sealing roots (שורשי-האיטום) ────────────────────────────

model SealRecord {
  id          String       @id @default(cuid())
  height      Int          @unique // chain height at seal time
  root        String       @unique // merkle root of the batch (hex)
  leavesCount Int
  stateRoot   String // sha256 of canonical kernel state
  gasUsed     Int
  note        String?
  createdAt   DateTime     @default(now())
  anchors     AnchorTx[]
  leaves      SealLeaf[]
  receipts    EvidenceReceipt[]
  signatures  PendingSignature[]

  @@index([createdAt])
}

model SealLeaf {
  id      String     @id @default(cuid())
  sealId  String
  seal    SealRecord @relation(fields: [sealId], references: [id], onDelete: Cascade)
  index   Int
  kind    String // stamp | seal | harvest | relay | wallet
  payload String // canonical JSON of the leaf
  digest  String // sha256 of canonical payload

  @@unique([sealId, index])
  @@index([digest])
}

// ─── Public anchoring (העגינה הציבורית) ──────────────────────────────────────

model AnchorTx {
  id        String      @id @default(cuid())
  sealId    String?
  seal      SealRecord? @relation(fields: [sealId], references: [id])
  network   String // STEEM | BLURT | HIVE | TRON
  kind      String // weave | checkpoint | identity
  txid      String? // null while pending/gated — honest, never fabricated
  status    String // anchored | pending | gated | transit
  gate      String? // why not anchored yet (rc-floor, cooldown, energy-0 ...)
  meta      String? // JSON extras (rc %, energy, cooldown minutes...)
  createdAt DateTime    @default(now())

  @@index([network, status])
  @@index([sealId])
}

// ─── Energy sovereignty (ריבונות אנרגיה) ─────────────────────────────────────

model EnergyPlan {
  id          String   @id @default(cuid())
  network     String // TRON | HIVE
  mode        String // energize | rc-recovery (planning artifacts — execution is a later stage)
  trxStaked   Int? // TRX (planning input)
  energyOut   Int? // estimated daily energy
  settlements Int? // USDT settlements per day (~65k energy each)
  burnCost    Int? // TRX/day (rounded) if no staking
  rcFloorPct  Float? // hive floors
  notes       String?
  payload     String // integer-safe plan JSON (canonical discipline)
  createdAt   DateTime @default(now())

  @@index([network, createdAt])
}

// ─── Economy (המשק — harvest & grid) ────────────────────────────────────────

model EconomySnapshot {
  id          String   @id @default(cuid())
  label       String
  inputs      String // JSON inputs (display data, not digested)
  streams     String // JSON per-stream output
  totalPerDay Float
  flywheelPct Float
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ─── Evidence (ראיות — hash-chained receipts) ────────────────────────────────

model EvidenceReceipt {
  id         String      @id @default(cuid())
  kind       String // seal | selftest | verify-pack | energy-plan | economy-sim | verify-chain
  digest     String      @unique
  prevDigest String?
  at         DateTime? // forge time — part of the digest; legacy rows backfilled digest-proven
  payload    String
  seal       SealRecord? @relation(fields: [sealId], references: [id])
  sealId     String?
  createdAt  DateTime    @default(now())

  @@index([kind])
}

// ─── Research verdict ledger (פסק-הדין של המחקר) ─────────────────────────────

model ResearchFinding {
  id       String @id @default(cuid())
  archive  String @unique
  rank     Int
  score    Int // 0..100 trailblazer score
  verdict  String
  salvage  String // JSON top salvage items
  evidence String // JSON validation evidence
}

// ─── Ops audit (יומן תפעול) ─────────────────────────────────────────────────

model OpLog {
  id        String   @id @default(cuid())
  op        String
  detail    String?
  createdAt DateTime @default(now())

  @@index([op])
}

// ─── Security audit (יומן ביקורת אבטחה — Task 5) ─────────────────────────────
// Records every sensitive-operation attempt (allowed or denied).
// Privacy discipline: NO key material, NO raw secrets; actor is a role label
// and ip is a truncated hash — enough for incident response, not for profiling.

model AuditEvent {
  id        String   @id @default(cuid())
  kind      String // auth-login | auth-login-failed | auth-logout | sensitive-denied | sensitive-allowed | signer-create | signer-result | live-gate-attempt
  actor     String // "anonymous" | "bearer" | "cookie:<8hex>" — never key material
  action    String // endpoint / operation attempted
  allowed   Boolean
  ipHash    String? // sha256(ip) truncated — coarse, correlation-only
  detail    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// ─── Keyless signing queue (תור חתימה ללא-מפתחות — Task 5) ───────────────────
// The system prepares a transaction FOR signing; it NEVER holds, stores or
// transmits private keys. Only the PUBLIC result (txid) is recorded back.
// By column design there is no place where a private key could even be saved.

model PendingSignature {
  id           String       @id @default(cuid())
  sealId       String?
  seal         SealRecord?  @relation(fields: [sealId], references: [id])
  network      String // STEEM | BLURT | HIVE | TRON
  kind         String // weave | checkpoint
  payload      String // canonical JSON content to sign (public by construction)
  payloadHash  String // sha256 of payload
  digestToSign String // the exact hash the external signer signs out-of-band
  signer       String // none | external | manual | hardware
  signerStatus String // disconnected | ready | awaiting-approval | error
  txid         String? // filled ONLY with the public on-chain result after out-of-band signing
  resultAt     DateTime?
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  // ── Task 6: external-anchor lifecycle (public data only — no key column exists) ──
  status             String    @default("pending") // pending | awaiting-approval | signed-externally | recorded | failed | expired | cancelled
  proofRef           String?   // raw PUBLIC proof reference (explorer URL / block ref) — public data only
  anchorRef          String?   // public anchor reference (permlink / block height / op ref)
  verified           Boolean?  // null = not checked yet; true = txid verified vs public network; false = could not verify (reason in verificationSource)
  verificationSource String?   // the public endpoint/method that verified — or the honest reason it could not
  verifiedAt         DateTime?
  cancelReason       String?   // public reason for cancelled / failed
  cancelledAt        DateTime?

  @@index([signerStatus])
  @@index([status])
  @@index([network, createdAt])
}
